        {
          "id": "opt_a",
          "text": "36 m/s",
          "numeric": 36,
          "payload": {
            "error_type": "CORRECT",
            "remediation_tag": "model_boundary_constant_vs_variable",
            "severity": "NONE",
            "explanation": "Correct: v = dx/dt = 9t², so v(2) = 36 m/s."
          }
        },
        {
          "id": "opt_b",
          "text": "Cannot be determined — acceleration 'a' is not given",
          "numeric": null,
          "payload": {
            "error_type": "CONSTANT_ACCEL_MISAPPLIED",
            "remediation_tag": "model_boundary_constant_vs_variable",
            "severity": "PARTIAL_MENTAL_MODEL",
            "explanation": "Student reached for v = u + at and stalled because 'a' was not provided, instead of differentiating x(t) = 3t³."
          }
        },
        {
          "id": "opt_c",
          "text": "24 m/s",
          "numeric": 24,
          "payload": {
            "error_type": "POSITION_VS_VELOCITY",
            "remediation_tag": "model_boundary_constant_vs_variable",
            "severity": "PARTIAL_MENTAL_MODEL",
            "explanation": "Student evaluated the position x(2) = 24 m and reported it as the velocity."
          }
        },
        {
          "id": "opt_d",
          "text": "18 m/s",
          "numeric": 18,
          "payload": {
            "error_type": "POWER_RULE_SLIP",
            "remediation_tag": "arithmetic_execution",
            "severity": "SLIP",
            "explanation": "Student differentiated with a power-rule slip (3·3·2 = 18) instead of 9t² at t = 2."
          }
        }
      ],
      "rubric": {
        "patterns": [
          {
            "option_id": "opt_b",
            "any_of": ["cannot solve", "not provided", "a.*not given"],
            "all_of": ["v=u\\+at"],
            "none_of": [],
            "evidence_template": "Applied 1D Constant Acceleration equation (v = u + at) to a Variable Acceleration polynomial system x(t) = 3t³.",
            "evidence_pattern": "v\\s*=\\s*u\\s*\\+\\s*at"
          },
          {
            "option_id": "opt_c",
            "any_of": ["x\\(2\\)\\s*=\\s*24", "=\\s*3\\(2\\)\\^3", "=\\s*3\\*8"],
            "none_of": ["9t", "dx/dt", "derivative"],
            "evidence_template": "Evaluated position x(2) = 24 m and reported it as velocity.",
            "evidence_pattern": "3\\s*\\(?2\\)?\\^3\\s*=\\s*24|x\\(2\\)\\s*=\\s*24"
          }
        ]
      }
    },
    {
      "question_id": "kin_q_103",
      "target_node": "implicit_boundary_conds",
      "prompt": "A stone is dropped from a 45 m cliff. How long does it take to reach the ground? (g = 9.8 m/s²)",
      "correct_option_id": "opt_a",
      "expected_time_sec": 60,
      "options": [
        {
          "id": "opt_a",
          "text": "3.03 s",
          "numeric": 3.03,
          "payload": {
            "error_type": "CORRECT",
            "remediation_tag": "implicit_rest_state",
            "severity": "NONE",
            "explanation": "Correct: 'dropped' means u = 0, so s = ½gt² gives t = √(2·45/9.8) ≈ 3.03 s."
          }
        },
        {
          "id": "opt_b",
          "text": "Cannot be determined — u and v are missing",
          "numeric": null,
          "payload": {
            "error_type": "MISSED_REST_CONDITION",
            "remediation_tag": "implicit_rest_state",
            "severity": "PARTIAL_MENTAL_MODEL",
            "explanation": "Student failed to infer that 'dropped from rest' defines u = 0 m/s and claimed the problem cannot be solved."
          }
        },
        {
          "id": "opt_c",
          "text": "4.59 s",
          "numeric": 4.59,
          "payload": {
            "error_type": "DIVIDED_S_BY_G",
            "remediation_tag": "implicit_rest_state",
            "severity": "PARTIAL_MENTAL_MODEL",
            "explanation": "Student divided displacement by g (45/9.8 = 4.59 s), ignoring the ½t² structure of accelerated motion."
          }
        },
        {
          "id": "opt_d",
          "text": "9.18 s",
          "numeric": 9.18,
          "payload": {
            "error_type": "FORGOT_SQRT",
            "remediation_tag": "arithmetic_execution",
            "severity": "SLIP",
            "explanation": "Student computed 2·45/9.8 = 9.18 but forgot the square root."
          }
        }
      ],
      "rubric": {
        "patterns": [
          {
            "option_id": "opt_b",
            "any_of": ["missing.*(initial|u)", "cannot solve", "not (given|provided)"],
            "none_of": ["u\\s*=\\s*0"],
            "evidence_template": "Failed to infer that the phrase 'dropped from rest' explicitly defines initial velocity u = 0 m/s.",
            "evidence_pattern": "missing initial velocity[^.]*|cannot solve[^.]*"
          },
          {
            "option_id": "opt_c",
            "any_of": ["45\\s*/\\s*9\\.8", "=\\s*4\\.59"],
            "none_of": ["sqrt", "√", "\\^\\(1/2\\)"],
            "evidence_template": "Divided displacement by g (45/9.8), ignoring accelerated-motion structure.",
            "evidence_pattern": "45\\s*/\\s*9\\.8\\s*=\\s*4\\.59"
          }
        ]
      }
    },
