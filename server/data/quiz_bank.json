{
  "questions": [
    {
      "question_id": "kin_q_101",
      "target_node": "coord_sign_conventions",
      "prompt": "A ball is thrown straight up at 20 m/s. Taking upward as positive and g = 9.8 m/s², what is its displacement at t = 3 s?",
      "correct_option_id": "opt_a",
      "expected_time_sec": 60,
      "options": [
        {
          "id": "opt_a",
          "text": "15.9 m",
          "numeric": 15.9,
          "payload": {
            "error_type": "CORRECT",
            "remediation_tag": "sign_convention_gravity",
            "severity": "NONE",
            "explanation": "Correct: s = ut + ½at² with a = −9.8 m/s² gives s = 60 − 44.1 = 15.9 m."
          }
        },
        {
          "id": "opt_b",
          "text": "104.1 m",
          "numeric": 104.1,
          "payload": {
            "error_type": "SIGN_CONVENTION_INVERSION",
            "remediation_tag": "sign_convention_gravity",
            "severity": "SYSTEMIC_MISCONCEPTION",
            "explanation": "Student assigned positive acceleration (+9.8) to gravity while defining upward displacement as positive (+20), computing s = (20)(3) + 0.5·9.8·(3²) = 104.1 m."
          }
        },
        {
          "id": "opt_c",
          "text": "60.0 m",
          "numeric": 60.0,
          "payload": {
            "error_type": "ACCELERATION_OMISSION",
            "remediation_tag": "constant_accel_eqs",
            "severity": "PARTIAL_MENTAL_MODEL",
            "explanation": "Student calculated s = u·t and entirely omitted the acceleration term ½at², giving 20·3 = 60.0 m."
          }
        },
        {
          "id": "opt_d",
          "text": "30.6 m",
          "numeric": 30.6,
          "payload": {
            "error_type": "SQUARING_ERROR",
            "remediation_tag": "arithmetic_execution",
            "severity": "SLIP",
            "explanation": "Student squared the time incorrectly (t² as 6), computing 60 − 0.5·9.8·6 = 30.6 m."
          }
        }
      ],
      "rubric": {
        "patterns": [
          {
            "option_id": "opt_b",
            "any_of": ["\\+?0\\.5\\*\\(?\\+?9\\.8\\)?\\*"],
            "none_of": ["-9\\.8", "\\(-9\\.8\\)"],
            "evidence_template": "Assigned positive acceleration (+9.8) to gravity while defining upward displacement as positive (+20).",
            "evidence_pattern": "0\\.5\\s*\\*\\s*\\+?9\\.8\\s*\\*\\s*\\(?3\\^2\\)?"
          },
          {
            "option_id": "opt_c",
            "any_of": ["^s=\\(?20\\)?\\*\\(?3\\)?=?60"],
            "none_of": ["0\\.5", "9\\.8", "4\\.9"],
            "evidence_template": "Computed displacement as s = u·t only, omitting the ½at² term entirely.",
            "evidence_pattern": "s\\s*=\\s*\\(?20\\)?\\s*\\*?\\s*\\(?3\\)?\\s*=?\\s*60"
          }
        ]
      }
    },
    {
      "question_id": "kin_q_102",
      "target_node": "variable_accel_calculus",
      "prompt": "A particle moves with position x(t) = 3t³ (metres, seconds). Find its velocity at t = 2 s.",
      "correct_option_id": "opt_a",
